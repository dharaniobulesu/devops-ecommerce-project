# required in the Docker build context for Jenkins CI builds
!application/corporate-ca-bundle.crt

# Downloaded binaries (not project source)
*.exe

# OS files
.DS_Store

# Kubernetes credentials
.kube/
kubeconfig
kubeconfig.*

# Docker credentials
.docker/
